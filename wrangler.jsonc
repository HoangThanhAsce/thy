// Cloudflare Workers Builds runs `npm run build` (static export to ./out)
// and then `npx wrangler deploy`, which serves ./out as static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thy",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
